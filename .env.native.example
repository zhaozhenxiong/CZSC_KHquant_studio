# CZSC runtime; business paths are relative to ./app
KHQUANT_ENV_SCHEMA=2
KHQUANT_PROJECT_ROOT="./app"
KHQUANT_VENV_DIR="./.venv-win"
KHQUANT_DATA_ROOT="./my_strategy/data"
KHQUANT_RAW_DB="./my_strategy/data/raw/khquant_raw.db"
KHQUANT_ARTIFACT_ROOT="./my_strategy/artifacts"
KHQUANT_LOG_ROOT="./my_strategy/data/logs"
KHQUANT_METADATA_ROOT="./my_strategy/data/metadata"
KHQUANT_DASHBOARD_PORT=8124
KHQUANT_COMPUTE_DEVICE=cpu
KHQUANT_CPU_WORKERS=4
KHQUANT_GPU_BATCH_SIZE=32
KHQUANT_DASHBOARD_HOST=127.0.0.1
PYTHONPATH="./app"
TZ=Asia/Shanghai
# Optional for non-loopback access: KHQUANT_API_TOKEN
