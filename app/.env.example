# KHQuant Docker runtime defaults.
# Copy to .env for local overrides. Do not commit real secrets or broker creds.

KHQUANT_IMAGE=khquant:local
KHQUANT_PYTHON_BASE_IMAGE=python:3.12-slim
KHQUANT_TZ=Asia/Shanghai
KHQUANT_DATA_ROOT=/app/my_strategy/data
KHQUANT_STORAGE_MODE=db
KHQUANT_RAW_DB=/app/my_strategy/data/raw/khquant_raw.db
KHQUANT_PROCESSED_DB=/app/my_strategy/data/processed/warehouse/khquant.db

# Registry deployment mode. Override KHQUANT_IMAGE on servers or CI consumers.
# Example: KHQUANT_IMAGE=ghcr.io/OWNER/REPO:latest

# Single-stock backtest mode.
KHQUANT_STOCKS=002436.SZ
KHQUANT_START=2026-01-01
KHQUANT_END=2026-07-14

# Screening mode. Keep max-stocks small for smoke runs.
KHQUANT_SCREEN_STOCKS=local
KHQUANT_SCREEN_START=2026-01-01
KHQUANT_SCREEN_END=2026-07-15
KHQUANT_SCREEN_MAX_STOCKS=100
KHQUANT_SCREEN_TOP=50

# Direct batch runner mode.
KHQUANT_BATCH_STOCKS=local
KHQUANT_BATCH_START=2026-01-01
KHQUANT_BATCH_END=2026-07-15
KHQUANT_BATCH_MAX_STOCKS=100

# Docker fast overlay. This mode mounts data/artifacts only and expects the
# image to contain current source code.
KHQUANT_TRAIN_STOCKS=local
KHQUANT_TRAIN_END=2026-07-15
KHQUANT_BENCHMARK_MODE=fast-screen
KHQUANT_PACKAGE_TARGET=/data/processed/maintenance_logs/khquant_package

# Data update mode. Defaults are intentionally narrow.
KHQUANT_UPDATE_MODE=custom
KHQUANT_UPDATE_STOCKS=002436.SZ

# Strategy acceptance mode. Default is leakage-only for fast smoke checks.
KHQUANT_ACCEPTANCE_MODE=leakage-only
KHQUANT_ACCEPTANCE_STOCKS=002436.SZ
KHQUANT_ACCEPTANCE_START=2026-01-01
KHQUANT_ACCEPTANCE_END=2026-07-14

# Docker-first local watch mode. Source changes sync into the container and rerun acceptance.
KHQUANT_WATCH_ACCEPTANCE_MODE=leakage-only
KHQUANT_WATCH_STOCKS=002436.SZ
KHQUANT_WATCH_START=2026-01-01
KHQUANT_WATCH_END=2026-07-14
KHQUANT_WATCH_SERVICE=khquant-watch
KHQUANT_WATCH_NO_UP=0

# Development notebook mode.
KHQUANT_JUPYTER_PORT=8888
KHQUANT_JUPYTER_TOKEN=khquant
